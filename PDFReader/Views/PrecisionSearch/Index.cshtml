        // Search phrase in PDF viewer
        async function searchPhraseInPDF(searchTerm, pageNumber, fullPhraseText) {

        searchTerm = searchTerm.replace('[', '').replace(']', '').trim();
        // Check if it's content search before removing *
        const isContentSearch = searchTerm.startsWith('*');
        if (isContentSearch) {
        searchTerm = searchTerm.substring(1);
        }
        // Store search type for highlighting
        window.currentSearchType = isContentSearch ? 'content' : 'word';

        // Check if PDF is loaded
        if (!pdfDoc) {
        alert('PDF not loaded. Please load a PDF file first.');
        return;
        }

        debugLog('Searching phrase in PDF', {
        searchTerm,
        pageNumber,
        fullPhraseText: fullPhraseText.substring(0, 100) + '...'
        });

        try {
        // Clear any existing highlights first
        const existingCanvas = document.getElementById('highlight-canvas');
        if (existingCanvas) {
        const ctx = existingCanvas.getContext('2d');
        ctx.clearRect(0, 0, existingCanvas.width, existingCanvas.height);
        }

        // Navigate to the specific page
        if (pageNumber && pageNumber >= 1 && pageNumber <= pdfDoc.numPages) {
        currentPage = pageNumber;
        await goToPage(pageNumber);
        
        // If View PDF mode is active, sync page in raw PDF viewer
        const toggle = document.getElementById("toggleOriginalPdf");
        if (toggle && toggle.checked && rawPdfBlobUrl) {
            document.getElementById("originalPdfEmbed").src = `${rawPdfBlobUrl}#page=${pageNumber}&toolbar=1&navpanes=0`;
        }
        await new Promise(resolve => setTimeout(resolve, 100));
        }

        // Update search box and trigger highlighting
        document.getElementById('searchBox').value = searchTerm;
        await renderPage(currentPage, searchTerm);

        // Auto-scroll to show highlighted text
        await scrollToHighlight(searchTerm);

        // Update search stats
        const statsDiv = document.getElementById('searchStats');
        const originalStats = statsDiv.textContent;

        statsDiv.innerHTML = `
        <div style="margin-bottom: 4px;">${originalStats}</div>
        <div style="font-size: 10px; color: #888; font-style: italic;">
        Phrase: "${fullPhraseText.length > 80 ? fullPhraseText.substring(0, 80) + '...' : fullPhraseText}"
        </div>
        `;

        debugLog('Phrase search completed', {
        navigatedToPage: pageNumber,
        searchTerm: searchTerm
        });

        } catch (error) {
        console.error('Error searching phrase in PDF:', error);
        alert('Error occurred while searching phrase in PDF.');
        }
        }

        // Auto-scroll to highlighted text
        async function scrollToHighlight(searchTerm) {
        await new Promise(resolve => setTimeout(resolve, 300));

        const pdfViewer = document.querySelector('.pdf-viewer');
        const pdfContainer = document.getElementById('pdf-container');

        // Get current page text content to find highlight position
        if (!pdfDoc) return;

        try {
        const page = await pdfDoc.getPage(currentPage);
        const textContent = await page.getTextContent();
        const viewport = page.getViewport({ scale: currentScale, rotation: currentRotation });

        let foundY = null;
        let foundX = null;

        // Build text and find match position
        let fullText = '';
        const itemMap = [];

        textContent.items.forEach((item, index) => {
        const startPos = fullText.length;
        fullText += item.str;
        if (item.hasEOL || (index < textContent.items.length - 1 && !item.str.endsWith(' '))) {
        fullText += ' ';
        }
        itemMap.push({ item, startPos, endPos: fullText.length });
        });

        // Find first match
        const escapedTerm = searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        let regex;
        if (window.currentSearchType === 'content') {
        regex = new RegExp(escapedTerm, 'gi');
        } else {
        regex = new RegExp(`\\b${escapedTerm}\\b`, 'gi');
        }

        const match = regex.exec(fullText);
        if (match) {
        // Find the text item containing this match
        for (const mapping of itemMap) {
        if (mapping.startPos <= match.index && mapping.endPos > match.index) {
        const tx = pdfjsLib.Util.transform(viewport.transform, mapping.item.transform);
        foundY = tx[5];
        foundX = tx[4];
        break;
        }
        }
        }

        if (foundY !== null && foundX !== null) {
        // Calculate scroll position to center the found text
        const containerRect = pdfContainer.getBoundingClientRect();
        const viewerRect = pdfViewer.getBoundingClientRect();

        const scrollX = foundX - (viewerRect.width / 2);
        const scrollY = foundY - (viewerRect.height / 2);

        pdfViewer.scrollTo({
        left: Math.max(0, scrollX),
        top: Math.max(0, scrollY),
        behavior: 'smooth'
        });
        }
        } catch (error) {
        console.error('Error scrolling to highlight:', error);
        }
        }

        // Add CSS for phrase active state
        const phraseStyles = document.createElement('style');
        phraseStyles.textContent = `
        .phrase-clickable {
        position: relative;
        }

        .phrase-clickable:hover {
        box-shadow: 0 2px 5px rgba(0,123,255,0.2);
        }

        .phrase-active {
        background: #e3f2fd !important;
        border-color: #007bff !important;
        box-shadow: 0 2px 8px rgba(0,123,255,0.3) !important;
        }

        .phrase-clickable::before {
        content: '';
        position: absolute;
        left: -8px;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        background: #007bff;
        transition: height 0.2s ease;
        }

        .phrase-clickable:hover::before,
        .phrase-active::before {
        height: 70%;
        }
        `;
        document.head.appendChild(phraseStyles);

        // Page navigation event listeners
        document.getElementById('firstPage').addEventListener('click', () => goToPage(1));
        document.getElementById('prevPage').addEventListener('click', () => goToPage(currentPage - 1));
        document.getElementById('nextPage').addEventListener('click', () => goToPage(currentPage + 1));
        document.getElementById('lastPage').addEventListener('click', () => goToPage(pdfDoc ? pdfDoc.numPages : 1));

        document.getElementById('goToPage').addEventListener('click', () => {
        const pageNum = parseInt(document.getElementById('pageInput').value);
        goToPage(pageNum);
        });

        document.getElementById('pageInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
        const pageNum = parseInt(e.target.value);
        goToPage(pageNum);
        }
        });

        // Zoom event listeners
        document.getElementById('zoomIn').addEventListener('click', zoomIn);
        document.getElementById('zoomOut').addEventListener('click', zoomOut);
        document.getElementById('fitWidth').addEventListener('click', () => setZoom('fit-width'));

        // Scale select change
        document.getElementById('scaleSelect').addEventListener('change', (e) => {
        const scale = e.target.value;
        if (scale === 'fit-width') {
        setZoom('fit-width');
        } else {
        setZoom(parseFloat(scale));
        }
        });

        // Add missing essential functions for highlighting

        // Create accurate text layer with highlighting
        async function createTextLayer(textContent, viewport, searchTerm = '') {
        // Always use canvas method since the search section is hidden
        await createCanvasHighlights(textContent, viewport, searchTerm);
        }

        // Method: Canvas-based highlighting with word boundary or content matching
        async function createCanvasHighlights(textContent, viewport, searchTerm) {
        if (!searchTerm) return;

        // Create a separate canvas for highlights
        let highlightCanvas = document.getElementById('highlight-canvas');
        if (!highlightCanvas) {
        highlightCanvas = document.createElement('canvas');
        highlightCanvas.id = 'highlight-canvas';
        highlightCanvas.style.position = 'absolute';
        highlightCanvas.style.top = '0';
        highlightCanvas.style.left = '0';
        highlightCanvas.style.pointerEvents = 'none';
        container.appendChild(highlightCanvas);
        }

        highlightCanvas.width = canvas.width;
        highlightCanvas.height = canvas.height;
        const highlightCtx = highlightCanvas.getContext('2d');

        highlightCtx.clearRect(0, 0, highlightCanvas.width, highlightCanvas.height);
        highlightCtx.fillStyle = 'rgba(255, 255, 0, 0.4)';

        // Build full text with position mapping
        let fullText = '';
        const itemMap = [];

        textContent.items.forEach((item, index) => {
        const startPos = fullText.length;
        fullText += item.str;
        if (item.hasEOL || (index < textContent.items.length - 1 && !item.str.endsWith(' '))) {
        fullText += ' ';
        }
        itemMap.push({
        item: item,
        startPos: startPos,
        endPos: fullText.length,
        index: index
        });
        });

        // Create regex based on search type
        const escapedTerm = searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        let regex;
        if (window.currentSearchType === 'content') {
        // Content search - simple contains matching
        regex = new RegExp(escapedTerm, 'gi');
        } else {
        // Word boundary search - exact word/phrase matching
        regex = new RegExp(`\\b${escapedTerm}\\b`, 'gi');
        }

        let match;
        while ((match = regex.exec(fullText)) !== null) {
        const matchStart = match.index;
        const matchEnd = match.index + match[0].length;

        // Highlight items that contain this match
        itemMap.forEach(mapping => {
        if (mapping.startPos < matchEnd && mapping.endPos > matchStart) {
        const tx = pdfjsLib.Util.transform(viewport.transform, mapping.item.transform);

        const x = tx[4];
        const y = tx[5] - mapping.item.height;
        const width = mapping.item.width;
        const height = mapping.item.height;

        highlightCtx.fillRect(x, y, width, height);
        }
        });
        }
        }

        // Get page text for searching
        async function getPageText(pageNum) {
        if (searchCache.has(pageNum)) {
        return searchCache.get(pageNum);
        }

        const page = await pdfDoc.getPage(pageNum);
        const textContent = await page.getTextContent();
        let text = '';
        textContent.items.forEach((item, index) => {
        text += item.str;
        if (item.hasEOL || (index < textContent.items.length - 1 && !item.str.endsWith(' '))) {
        text += ' ';
        }
        });

        searchCache.set(pageNum, text);
        return text;
        }

        // Zoom Functions
        async function setZoom(scale) {
        if (scale === 'fit-width') {
        currentScale = await calculateFitWidthScale();
        document.getElementById('scaleSelect').value = 'fit-width';
        } else {
        currentScale = Math.max(0.1, Math.min(5.0, scale));
        currentZoomIndex = zoomLevels.indexOf(currentScale);
        if (currentZoomIndex === -1) {
        // Find closest zoom level
        currentZoomIndex = zoomLevels.reduce((prev, curr, index) => {
        return Math.abs(curr - currentScale) < Math.abs(zoomLevels[prev] - currentScale) ? index : prev;
        }, 0);
        }
        }

        const searchTerm = document.getElementById('searchBox').value.trim();
        await renderPage(currentPage, searchTerm);
        }

        async function zoomIn() {
        if (currentZoomIndex < zoomLevels.length - 1) {
        currentZoomIndex++;
        await setZoom(zoomLevels[currentZoomIndex]);
        }
        }

        async function zoomOut() {
        if (currentZoomIndex > 0) {
        currentZoomIndex--;
        await setZoom(zoomLevels[currentZoomIndex]);
        }
        }

        // Rotation Functions
        async function rotateClockwise() {
        currentRotation = (currentRotation + 90) % 360;
        const searchTerm = document.getElementById('searchBox').value.trim();
        await renderPage(currentPage, searchTerm);
        }

        async function rotateCounterClockwise() {
        currentRotation = (currentRotation - 90 + 360) % 360;
        const searchTerm = document.getElementById('searchBox').value.trim();
        await renderPage(currentPage, searchTerm);
        }

        async function resetRotation() {
        currentRotation = 0;
        const searchTerm = document.getElementById('searchBox').value.trim();
        await renderPage(currentPage, searchTerm);
        }

        // Event listeners for search functionality (even though section is hidden)
        document.getElementById('searchBtn').addEventListener('click', () => {
        const term = document.getElementById('searchBox').value.trim();
        performSearch(term);
        });

        document.getElementById('cancelBtn').addEventListener('click', () => {
        if (searchController) {
        searchController.abort();
        }
        });

        document.getElementById('searchBox').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
        const term = e.target.value.trim();
        performSearch(term);
        }
        });

        // Debug mode toggle
        document.getElementById('debugMode').addEventListener('change', (e) => {
        if (!e.target.checked) {
        clearDebug();
        }
        });

        // Memory cleanup
        window.addEventListener('beforeunload', () => {
        searchCache.clear();
        renderCache.clear();
        if (searchController) {
        searchController.abort();
        }
        });

        // Window resize handler for fit-width
        window.addEventListener('resize', () => {
        containerWidth = container.clientWidth;
        if (document.getElementById('scaleSelect').value === 'fit-width') {
        setZoom('fit-width');
        }
        });

        // Rotation Controls
        document.getElementById('rotateLeft').addEventListener('click', rotateCounterClockwise);
        document.getElementById('rotateRight').addEventListener('click', rotateClockwise);
        document.getElementById('resetRotation').addEventListener('click', resetRotation);

        // Elements
        const toggle = document.getElementById("toggleOriginalPdf");
        const originalContainer = document.getElementById("originalPdfContainer");
        const pdfViewer = document.querySelector(".pdf-viewer");

        // Render or re-instantiate raw PDF viewer at specific page
        function renderOriginalPdf(pageNum) {
            pageNum = pageNum || currentPage || 1;
            const container = document.getElementById("originalPdfContainer");
            if (!container) return;

            if (rawPdfBlobUrl) {
                // Completely replacing container.innerHTML forces the browser PDF plugin to re-instantiate cleanly
                container.innerHTML = `<embed id="originalPdfEmbed" type="application/pdf" src="${rawPdfBlobUrl}#page=${pageNum}&toolbar=1&navpanes=0" style="width:100%; height:100%; border:0;" />`;
            } else {
                container.innerHTML = `
                    <div style="text-align: center; padding: 50px 20px; color: #666;">
                        <i class="fas fa-file-pdf" style="font-size: 48px; color: #ccc; margin-bottom: 15px;"></i><br>
                        No PDF file loaded yet. Please select a PDF file first.
                    </div>`;
            }
        }

        // Toggle behavior: show original in the same viewer area and jump to exact currentPage
        toggle.addEventListener("change", function () {
        if (this.checked) {
            // show original and jump to the exact page the user was checking
            renderOriginalPdf(currentPage);
            originalContainer.style.display = "block";
            pdfViewer.style.display = "none";
        } else {
            // return to custom viewer and re-render current page
            originalContainer.style.display = "none";
            pdfViewer.style.display = "flex";
            if (pdfDoc) {
                renderPage(currentPage);
            }
        }
        });


        // Auto-download JSON silently to the browser's default Downloads folder (no dialog)
        function downloadJsonSilent(jsonData, fileName) {
            const jsonString = JSON.stringify(jsonData, null, 2);
            fileName = fileName || `search-results-${new Date().toISOString().replace(/[:.]/g, '-')}.json`;
            const blob = new Blob([jsonString], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Save JSON via native OS "Save As" dialog — called only when user explicitly clicks the green save icon
        async function saveJsonToFile(jsonData, defaultFileName) {
            const jsonString = JSON.stringify(jsonData, null, 2);
            const fileName = defaultFileName || `search-results-${new Date().toISOString().replace(/[:.]/g, '-')}.json`;

            // Try File System Access API (opens native Save Dialog with pre-filled name)
            if (window.showSaveFilePicker) {
                try {
                    const fileHandle = await window.showSaveFilePicker({
                        suggestedName: fileName,
                        types: [{
                            description: 'JSON Files',
                            accept: { 'application/json': ['.json'] }
                        }]
                    });
                    const writable = await fileHandle.createWritable();
                    await writable.write(jsonString);
                    await writable.close();
                    debugLog('JSON saved to selected location', { fileName });
                    return;
                } catch (err) {
                    if (err.name === 'AbortError') return; // user cancelled
                    console.warn('showSaveFilePicker failed, falling back to download:', err);
                }
            }

            // Fallback: standard download if File System Access API unavailable
            downloadJsonSilent(jsonData, fileName);
        }
    </script>

</body>
</html>
